# ============================================================
# CFCT Staging Environment (near production)
# Copy to .env.staging and update values before running.
# ============================================================

SECRET_KEY=replace-with-strong-staging-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,staging.your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://staging.your-domain.com
CORS_ALLOWED_ORIGINS=https://staging.your-domain.com
CORS_ALLOW_ALL_ORIGINS=False
FRONTEND_BASE_URL=https://staging.your-domain.com

DB_NAME=cfct_staging
DB_USER=cfct_staging_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-with-smtp-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@staging.your-domain.com

THROTTLE_RATE_USER=240/minute
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_LOGIN=10/minute

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# If staging is behind HTTPS proxy/ingress, set:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

AUDIT_LOG_RETENTION_DAYS=365
PAYMENT_WEBHOOK_SIGNATURE_SECRET=replace-with-webhook-signature-secret
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-Azampay-Signature
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=True

# Monitoring probes (public)
# /api/health/live/
# /api/health/ready/

AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
