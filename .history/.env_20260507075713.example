# ============================================================
# CFCT Church Management System — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# ---- Django Core ----
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_BASE_URL=https://yourdomain.com

# ---- Database (PostgreSQL required in production) ----
DB_NAME=cfct_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Set to True only when running tests without a Postgres instance
USE_SQLITE_FOR_TESTS=False

# ---- Email (SMTP) ----
# Leave EMAIL_HOST empty to fall back to console output in development.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to True in tests / local dev to run tasks synchronously
CELERY_TASK_ALWAYS_EAGER=False
REDIS_URL=redis://localhost:6379

# ---- Rate Limiting ----
THROTTLE_RATE_USER=240/minute
THROTTLE_RATE_ANON=60/minute
THROTTLE_RATE_LOGIN=10/minute

# ---- Security (production only) ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Set DEBUG=False with a strong SECRET_KEY in all non-local environments.
# Django now fails fast on startup in production if SECRET_KEY is missing/default.

# ---- Monitoring ----
# Public health probes (no auth):
# - /api/health/live/
# - /api/health/ready/

# ---- Login Lockout Policy ----
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# ---- Email Verification ----
# Seconds before a verification link expires (default 86400 = 24 h)
EMAIL_VERIFICATION_TIMEOUT=86400

# ---- Audit Log Retention ----
# Delete admin audit logs older than this number of days
AUDIT_LOG_RETENTION_DAYS=365

# ---- Tanzania Payment Gateway — Azampay ----
# Obtain credentials at https://azampay.co.tz
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-Azampay-Signature
PAYMENT_WEBHOOK_REQUIRE_SIGNATURE=True

# ---- Church Bank Account Details ----
CHURCH_BANK_NAME=CRDB Bank
CHURCH_BANK_ACCOUNT_NUMBER=
CHURCH_BANK_ACCOUNT_NAME=CFCT Church
CHURCH_BANK_BRANCH=
CHURCH_BANK_SWIFT_CODE=
